# ============================================================================
# STAGE 2: DBT TRANSFORMATION (Staging → Intermediate → Warehouse)
# ============================================================================

def run_dbt_command(command: str) -> str:
    """Execute dbt command and capture output."""
    import subprocess
    
    try:
        env = os.environ.copy()
        env["DBT_PROFILES_DIR"] = DBT_PROFILES_DIR
        env["DBT_PROJECT_DIR"] = DBT_PROJECT_DIR
        
        result = subprocess.run(
            f"dbt {command}",
            shell=True,
            cwd=DBT_PROJECT_DIR,
            env=env,
            capture_output=True,
            text=True,
        )
        
        if result.returncode != 0:
            logger.error(f"dbt command failed:\n{result.stderr}")
            raise AirflowException(f"dbt {command} failed")
        
        logger.info(f"dbt {command} completed successfully")
        return result.stdout
        
    except Exception as e:
        logger.error(f"Error running dbt: {str(e)}")
        raise


