# ============================================================================
# STAGE 4: ML FEATURE ENGINEERING
# ============================================================================

def extract_ml_features(**context) -> str:
    """Query PFE_DWH and build feature matrix for ML training."""
    try:
        import pyodbc
        import pandas as pd
        
        logger.info("Starting ML feature extraction...")
        
        connection_string = (
            f"Driver={{ODBC Driver 17 for SQL Server}};"
            f"Server={SQL_SERVER},{SQL_PORT};"
            f"Database={SQL_DB};"
            f"UID={SQL_USER};"
            f"PWD={SQL_PASSWORD}"
        )
        
        conn = pyodbc.connect(connection_string)
        
        # Extract feature matrix from fact_customer_risk + dimensions
        query = """
        SELECT 
            fcr.customer_sk,
            fcr.compliance_risk_index,
            fcr.financial_fragility_score,
            fcr.behavioral_risk_score,
            fcr.global_risk_score,
            CASE WHEN fcr.global_risk_score >= 50 THEN 1 ELSE 0 END as target_high_risk,
            fcr.account_count,
            fcr.total_working_balance,
            fcr.avg_working_balance,
            fcr.negative_balance_account_count,
            fcr.oldest_account_age_days,
            fcr.customer_tenure_days,
            dc.is_kyc_complete,
            dc.is_pep,
            dc.is_compliance_flagged,
            dc.monthly_salary,
            dc.number_of_dependents,
            ds.sector_code,
            di.industry_code,
            dt.target_code,
            dd.dao_name
        FROM PFE_DWH.fact_customer_risk fcr
        JOIN PFE_DWH.dim_customer dc ON fcr.customer_sk = dc.customer_sk
        LEFT JOIN PFE_DWH.dim_sector ds ON dc.sector_code = ds.sector_code
        LEFT JOIN PFE_DWH.dim_industry di ON dc.industry_code = di.industry_code
        LEFT JOIN PFE_DWH.dim_target dt ON dc.target_code = dt.target_code
        LEFT JOIN PFE_DWH.dim_dao dd ON fcr.dao_sk = dd.dao_sk
        WHERE CAST(fcr.scoring_date AS DATE) = CAST(GETDATE() AS DATE)
        """
        
        df = pd.read_sql(query, conn)
        conn.close()
        
        logger.info(f"Extracted {len(df)} customer records for ML training")
        
        # Save feature matrix
        feature_output_path = f"{ML_MODELS_DIR}/features_latest.csv"
        os.makedirs(ML_MODELS_DIR, exist_ok=True)
        df.to_csv(feature_output_path, index=False)
        
        logger.info(f"Feature matrix saved to {feature_output_path}")
        
        context['task_instance'].xcom_push(key='ml_feature_path', value=feature_output_path)
        return feature_output_path
        
    except Exception as e:
        logger.error(f"ML feature extraction failed: {str(e)}")
        raise


# ============================================================================
# STAGE 5: ML MODEL TRAINING
# ============================================================================

def train_ml_models(feature_path: str, **context) -> dict:
    """Train XGBoost and Random Forest models on the feature matrix."""
    try:
        logger.info("Starting ML model training...")
        
        # Import ML modules
        from src.modeling import train_xgboost_model, train_random_forest_model
        from src.features import handle_imbalance, train_test_split
        import pandas as pd
        
        # Load features
        df = pd.read_csv(feature_path)
        logger.info(f"Loaded {len(df)} records from {feature_path}")
        
        # Split into features and target
        X = df.drop(columns=['customer_sk', 'target_high_risk'])
        y = df['target_high_risk']
        
        # Handle class imbalance with SMOTETomek
        X_balanced, y_balanced = handle_imbalance(X, y, method='smotetomek')
        logger.info(f"After SMOTETomek: {len(X_balanced)} records (class distribution: {y_balanced.value_counts().to_dict()})")
        
        # Train/test split
        X_train, X_test, y_train, y_test = train_test_split(X_balanced, y_balanced, test_size=0.2)
        
        # Train XGBoost
        logger.info("Training XGBoost model...")
        xgb_model, xgb_metrics = train_xgboost_model(X_train, X_test, y_train, y_test)
        logger.info(f"XGBoost F1 Score: {xgb_metrics.get('f1_score', 0):.4f}")
        
        # Train Random Forest
        logger.info("Training Random Forest model...")
        rf_model, rf_metrics = train_random_forest_model(X_train, X_test, y_train, y_test)
        logger.info(f"Random Forest F1 Score: {rf_metrics.get('f1_score', 0):.4f}")
        
        # Select best model
        best_model = xgb_model if xgb_metrics.get('f1_score', 0) > rf_metrics.get('f1_score', 0) else rf_model
        best_metrics = xgb_metrics if xgb_metrics.get('f1_score', 0) > rf_metrics.get('f1_score', 0) else rf_metrics
        
        logger.info(f"Best model: {'XGBoost' if best_model == xgb_model else 'Random Forest'}")
        
        # Save model
        model_path = f"{ML_MODELS_DIR}/best_model_latest.pkl"
        import pickle
        with open(model_path, 'wb') as f:
            pickle.dump(best_model, f)
        
        context['task_instance'].xcom_push(key='ml_model_path', value=model_path)
        context['task_instance'].xcom_push(key='ml_model_metrics', value=best_metrics)
        
        return {"model_path": model_path, "metrics": best_metrics}
        
    except Exception as e:
        logger.error(f"ML model training failed: {str(e)}")
        raise


def generate_shap_explanations(model_path: str, feature_path: str, **context) -> str:
    """Generate SHAP explanations for model predictions."""
    try:
        logger.info("Generating SHAP explanations...")
        
        from src.explainability import generate_shap_summary
        import pandas as pd
        import pickle
        
        # Load model and features
        with open(model_path, 'rb') as f:
            model = pickle.load(f)
        
        df = pd.read_csv(feature_path)
        X = df.drop(columns=['customer_sk', 'target_high_risk'])
        
        # Generate SHAP
        shap_output_path = f"{ML_MODELS_DIR}/shap_summary_latest.html"
        generate_shap_summary(model, X, output_path=shap_output_path)
        
        logger.info(f"SHAP explanations saved to {shap_output_path}")
        context['task_instance'].xcom_push(key='ml_shap_path', value=shap_output_path)
        
        return shap_output_path
        
    except Exception as e:
        logger.error(f"SHAP generation failed: {str(e)}")
        # Don't fail the pipeline if SHAP fails - it's optional
        logger.warning("Continuing without SHAP (optional)")
        return ""

# ============================================================================
# STAGE 6: BATCH PREDICTION
# ============================================================================

def make_batch_predictions(model_path: str, feature_path: str, **context) -> str:
    """Score all customers with the trained model and save predictions."""
    try:
        logger.info("Making batch predictions...")
        
        import pandas as pd
        import pickle
        import pyodbc
        
        # Load model and features
        with open(model_path, 'rb') as f:
            model = pickle.load(f)
        
        df = pd.read_csv(feature_path)
        X = df.drop(columns=['customer_sk', 'target_high_risk'])
        
        # Make predictions
        predictions = model.predict(X)
        prediction_probs = model.predict_proba(X)
        
        df['ml_predicted_high_risk'] = predictions
        df['ml_risk_probability'] = prediction_probs[:, 1]
        
        # Save predictions
        predictions_path = f"{ML_MODELS_DIR}/predictions_latest.csv"
        df.to_csv(predictions_path, index=False)
        
        # Load predictions back into SQL Server for serving
        connection_string = (
            f"Driver={{ODBC Driver 17 for SQL Server}};"
            f"Server={SQL_SERVER},{SQL_PORT};"
            f"Database={SQL_DB};"
            f"UID={SQL_USER};"
            f"PWD={SQL_PASSWORD}"
        )
        
        conn = pyodbc.connect(connection_string)
        cursor = conn.cursor()
        
        # Create or truncate predictions table
        cursor.execute("""
            IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'ml_predictions_latest')
            CREATE TABLE PFE_DWH.ml_predictions_latest (
                customer_sk INT,
                ml_predicted_high_risk BIT,
                ml_risk_probability DECIMAL(10,4),
                prediction_date DATETIME DEFAULT GETDATE()
            )
            ELSE
            TRUNCATE TABLE PFE_DWH.ml_predictions_latest
        """)
        
        # Insert predictions in batches
        batch_size = 1000
        for i in range(0, len(df), batch_size):
            batch = df.iloc[i:i+batch_size]
            for _, row in batch.iterrows():
                cursor.execute("""
                    INSERT INTO PFE_DWH.ml_predictions_latest 
                    (customer_sk, ml_predicted_high_risk, ml_risk_probability)
                    VALUES (?, ?, ?)
                """, row['customer_sk'], row['ml_predicted_high_risk'], row['ml_risk_probability'])
            conn.commit()
        
        cursor.close()
        conn.close()
        
        logger.info(f"Loaded {len(df)} predictions into PFE_DWH.ml_predictions_latest")
        context['task_instance'].xcom_push(key='ml_predictions_path', value=predictions_path)
        
        return predictions_path
        
    except Exception as e:
        logger.error(f"Batch prediction failed: {str(e)}")
        raise

# ============================================================================
# STAGE 7: MODEL MONITORING & ALERTS
# ============================================================================

def monitor_model_performance(**context) -> dict:
    """Check for data drift, model performance degradation, and other issues."""
    try:
        logger.info("Starting model monitoring...")
        
        # Pull ML metrics from context
        ml_metrics = context['task_instance'].xcom_pull(task_ids='train_ml_models', key='ml_model_metrics')
        
        alerts = []
        
        # Check F1 score (should be > 0.7)
        if ml_metrics.get('f1_score', 0) < 0.7:
            alerts.append(f"WARNING: F1 Score {ml_metrics['f1_score']:.4f} is below threshold (0.7)")
        
        # Check ROC-AUC (should be > 0.8)
        if ml_metrics.get('roc_auc', 0) < 0.8:
            alerts.append(f"WARNING: ROC-AUC {ml_metrics['roc_auc']:.4f} is below threshold (0.8)")
        
        # Check precision and recall balance
        precision = ml_metrics.get('precision', 0)
        recall = ml_metrics.get('recall', 0)
        
        if abs(precision - recall) > 0.15:
            alerts.append(f"WARNING: Precision-Recall imbalance (P={precision:.4f}, R={recall:.4f})")
        
        monitoring_results = {
            "metrics": ml_metrics,
            "alerts": alerts,
            "status": "OK" if len(alerts) == 0 else "WARNING",
        }
        
        for alert in alerts:
            logger.warning(alert)
        
        context['task_instance'].xcom_push(key='monitoring_results', value=monitoring_results)
        return monitoring_results
        
    except Exception as e:
        logger.error(f"Model monitoring failed: {str(e)}")
        raise

with TaskGroup("stage_4_ml_pipeline", dag=dag) as stage_4_ml:
    extract_features = PythonOperator(
        task_id="extract_features",
        python_callable=extract_ml_features,
    )
    
    train_models = PythonOperator(
        task_id="train_models",
        python_callable=train_ml_models,
        op_kwargs={"feature_path": "{{ task_instance.xcom_pull(task_ids='stage_4_ml_pipeline.extract_features', key='ml_feature_path') }}"},
    )
    
    generate_shap = PythonOperator(
        task_id="generate_shap",
        python_callable=generate_shap_explanations,
        op_kwargs={
            "model_path": "{{ task_instance.xcom_pull(task_ids='stage_4_ml_pipeline.train_models', key='ml_model_path') }}",
            "feature_path": "{{ task_instance.xcom_pull(task_ids='stage_4_ml_pipeline.extract_features', key='ml_feature_path') }}",
        },
    )
    
    batch_predictions = PythonOperator(
        task_id="batch_predictions",
        python_callable=make_batch_predictions,
        op_kwargs={
            "model_path": "{{ task_instance.xcom_pull(task_ids='stage_4_ml_pipeline.train_models', key='ml_model_path') }}",
            "feature_path": "{{ task_instance.xcom_pull(task_ids='stage_4_ml_pipeline.extract_features', key='ml_feature_path') }}",
        },
    )
    
    monitor = PythonOperator(
        task_id="monitor",
        python_callable=monitor_model_performance,
    )
    
    # Sequence
    extract_features >> train_models >> [generate_shap, batch_predictions] >> monitor

# ============================================================================
# PIPELINE ORCHESTRATION
# ============================================================================

stage_1_ingestion >> stage_2_transformation >> warehouse_validated >> stage_4_ml

# ============================================================================
# FINAL NOTIFICATION
# ============================================================================

def send_completion_notification(**context) -> None:
    """Send notification that the entire pipeline completed successfully."""
    try:
        logger.info("=" * 80)
        logger.info("✓ MASTER PIPELINE COMPLETED SUCCESSFULLY")
        logger.info("=" * 80)
        logger.info("Pipeline stages completed:")
        logger.info("  1. ✓ Data Ingestion (ODS loaded)")
        logger.info("  2. ✓ dbt Transformation (Warehouse built)")
        logger.info("  3. ✓ Warehouse Validation (Referential integrity checked)")
        logger.info("  4. ✓ ML Feature Engineering (Features extracted)")
        logger.info("  5. ✓ ML Model Training (Models trained and evaluated)")
        logger.info("  6. ✓ Batch Prediction (Predictions scored and loaded)")
        logger.info("  7. ✓ Model Monitoring (Performance validated)")
        logger.info("=" * 80)
        
    except Exception as e:
        logger.error(f"Notification failed: {str(e)}")


stage_4_ml >> PythonOperator(
    task_id="completion_notification",
    python_callable=send_completion_notification,
)
