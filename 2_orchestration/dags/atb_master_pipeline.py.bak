# ============================================================================
# STAGE 1: DATA INGESTION VIA AIRBYTE
# ============================================================================

def trigger_airbyte_sync(connection_id: str, table_name: str) -> dict:
    """Trigger an Airbyte connection sync and wait for completion."""
    try:
        import requests
        import time
        
        # Trigger the sync
        url = f"{AIRBYTE_API_URL}/api/v1/jobs"
        headers = {"Authorization": f"Bearer {AIRBYTE_API_KEY}"}
        payload = {"connectionId": connection_id}
        
        response = requests.post(url, json=payload, headers=headers)
        response.raise_for_status()
        job_id = response.json().get("job", {}).get("id")
        
        if not job_id:
            raise AirflowException(f"Failed to start Airbyte sync for {table_name}: no job ID returned")
        
        logger.info(f"Started Airbyte sync for {table_name}: job_id={job_id}")
        
        # Poll for completion (max 30 minutes)
        start_time = time.time()
        max_wait = 30 * 60  # 30 minutes
        
        while time.time() - start_time < max_wait:
            status_response = requests.get(
                f"{AIRBYTE_API_URL}/api/v1/jobs/{job_id}",
                headers=headers
            )
            status_response.raise_for_status()
            status = status_response.json().get("job", {}).get("status")
            
            if status == "succeeded":
                logger.info(f"Airbyte sync {table_name} completed successfully")
                return {"table": table_name, "status": "success", "job_id": job_id}
            elif status == "failed":
                raise AirflowException(f"Airbyte sync {table_name} failed: job_id={job_id}")
            
            time.sleep(10)  # Poll every 10 seconds
        
        raise AirflowException(f"Airbyte sync {table_name} timeout after 30 minutes")
        
    except Exception as e:
        logger.error(f"Error triggering Airbyte sync for {table_name}: {str(e)}")
        raise


def validate_ods_tables(**context) -> dict:
    """Validate that ODS tables were populated with latest data."""
    try:
        import pyodbc
        
        connection_string = (
            f"Driver={{ODBC Driver 17 for SQL Server}};"
            f"Server={SQL_SERVER},{SQL_PORT};"
            f"Database={SQL_DB};"
            f"UID={SQL_USER};"
            f"PWD={SQL_PASSWORD}"
        )
        
        conn = pyodbc.connect(connection_string)
        cursor = conn.cursor()
        
        ods_tables = [
            "ODS_ACCOUNT", "ODS_CUSTOMER", "ODS_CURRENCY", "ODS_DAO",
            "ODS_INDUSTRY", "ODS_SECTOR", "ODS_TARGET"
        ]
        
        validation_results = {}
        
        for table in ods_tables:
            cursor.execute(f"SELECT COUNT(*) FROM PFE_ODS.{table}")
            row_count = cursor.fetchone()[0]
            
            # Check if table is empty
            if row_count == 0:
                raise AirflowException(f"ODS table {table} is empty!")
            
            # Check if freshly loaded (within last hour)
            cursor.execute(f"""
                SELECT MAX(CAST(GETDATE() AS DATE)) as today
                FROM PFE_ODS.{table}
            """)
            
            validation_results[table] = {"row_count": row_count, "status": "ok"}
            logger.info(f"ODS {table}: {row_count} rows ✓")
        
        cursor.close()
        conn.close()
        
        context['task_instance'].xcom_push(key='ods_validation', value=validation_results)
        return validation_results
        
    except Exception as e:
        logger.error(f"ODS validation failed: {str(e)}")
        raise


