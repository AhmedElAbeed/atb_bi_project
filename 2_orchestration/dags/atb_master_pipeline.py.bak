# ============================================================================
# STAGE 3: WAREHOUSE VALIDATION
# ============================================================================

def validate_warehouse(**context) -> dict:
    """Validate fact tables have zero NULL FKs and correct row counts."""
    try:
        import pyodbc
        
        connection_string = (
            f"Driver={{ODBC Driver 17 for SQL Server}};"
            f"Server={SQL_SERVER},{SQL_PORT};"
            f"Database={SQL_DB};"
            f"UID={SQL_USER};"
            f"PWD={SQL_PASSWORD}"
        )
        
        conn = pyodbc.connect(connection_string)
        cursor = conn.cursor()
        
        validation = {
            "fact_customer_risk": {},
            "fact_account": {},
        }
        
        # Validate fact_customer_risk
        cursor.execute("""
            SELECT 
                COUNT(*) as total_rows,
                SUM(CASE WHEN customer_sk IS NULL THEN 1 ELSE 0 END) as null_customer_sk,
                SUM(CASE WHEN dao_sk IS NULL THEN 1 ELSE 0 END) as null_dao_sk,
                SUM(CASE WHEN risk_profile_sk IS NULL THEN 1 ELSE 0 END) as null_risk_profile_sk
            FROM PFE_DWH.fact_customer_risk
        """)
        
        row = cursor.fetchone()
        validation["fact_customer_risk"] = {
            "total_rows": row[0],
            "null_fks": sum([row[1], row[2], row[3]]),
            "status": "OK" if sum([row[1], row[2], row[3]]) == 0 and row[0] > 100000 else "FAILED",
        }
        
        # Validate fact_account
        cursor.execute("""
            SELECT 
                COUNT(*) as total_rows,
                SUM(CASE WHEN customer_sk IS NULL THEN 1 ELSE 0 END) as null_customer_sk,
                SUM(CASE WHEN dao_sk IS NULL THEN 1 ELSE 0 END) as null_dao_sk,
                SUM(CASE WHEN currency_sk IS NULL THEN 1 ELSE 0 END) as null_currency_sk
            FROM PFE_DWH.fact_account
        """)
        
        row = cursor.fetchone()
        validation["fact_account"] = {
            "total_rows": row[0],
            "null_fks": sum([row[1], row[2], row[3]]),
            "status": "OK" if sum([row[1], row[2], row[3]]) == 0 and row[0] > 100000 else "FAILED",
        }
        
        cursor.close()
        conn.close()
        
        # Fail if validation failed
        for fact_table, results in validation.items():
            if results["status"] != "OK":
                raise AirflowException(f"Warehouse validation failed for {fact_table}: {results}")
            logger.info(f"{fact_table}: {results['total_rows']} rows, {results['null_fks']} NULL FKs ✓")
        
        context['task_instance'].xcom_push(key='warehouse_validation', value=validation)
        return validation
        
    except Exception as e:
        logger.error(f"Warehouse validation failed: {str(e)}")
        raise


stage_validate_warehouse = PythonOperator(
    task_id="stage_3_validate_warehouse",
    python_callable=validate_warehouse,
    dag=dag,
)

